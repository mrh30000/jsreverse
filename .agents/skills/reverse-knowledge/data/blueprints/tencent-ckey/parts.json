      "example": "（多行 k=v）"
    },
    {
      "name": "vinfoparam",
      "role": "proxyhttp 的取址参数串（内含 logintoken / vid / cKey / encryptVer 等）",
      "source": "源文 line 120 的完整模板",
      "example": "spsrt=1&charge=0&…&encryptVer=9.1&cKey=…"
    }
