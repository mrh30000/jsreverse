*жң¬её–жңҖеҗҺз”ұ evlon дәҺ 2025-7-10 18:55 зј–иҫ‘*

### 01. иғҢжҷҜ

йЎ№зӣ®дёӯпјҢд№ жғҜзңӢзҪ‘з«ҷзҡ„жөҸи§ҲеҷЁжәҗз ҒпјҢдҪҶжҳҜиҝҷж¬ЎеҸӘиҰҒдёҖжү“ејҖејҖеҸ‘иҖ…е·Ҙе…·(devtool)пјҢжөҸи§ҲеҷЁе°ұи·іиҪ¬еҲ°дәҶвҖңabout:blank"гҖӮдәҺжҳҜпјҢжңүдәҶиҝҷдёӘж–Үз« гҖӮ

### 02. з ҙи§ЈжҖқи·Ҝ

1. жү“ејҖзҷҫеәҰ
2. жү“ејҖејҖеҸ‘иҖ…е·Ҙе…·(devtool),зӮ№еҮ»жәҗд»Јз Ғж ҮзӯҫпјҢжүҫеҲ°вҖңдәӢд»¶зӣ‘еҗ¬еҷЁж–ӯз”өвҖқпјҢйҖүдёӯвҖңеҠ иҪҪвҖқпјҢеӢҫйҖүвҖңbeforunload","unload"гҖӮиҝҷдёӘж„ҸжҖқжҳҜеңЁи·іиҪ¬еҲ° вҖқabout:blank"д№ӢеүҚпјҢдёӯж–ӯ
3. дҝқжҢҒејҖеҸ‘иҖ…е·Ҙе…·жү“ејҖпјҢеңЁең°еқҖж Ҹиҫ“е…Ҙзӣ®ж ҮзҪ‘еқҖпјҢжү“ејҖпјҢзӯүеҫ…дёӯж–ӯгҖӮ
4. йҖҡиҝҮе Ҷж ҲпјҢжүҫеҲ°зӣ®ж Үд»Јз ҒгҖӮ

   ```
   loadjs.d("./app/study/course/detail/index", function(e, n, a) {
   var t, l, i, s, o = e("lodash/collection"), r = e("./app/util/aes"), c = e("./app/util/business/fsearch-view-util"), d = e("disable-devtool"), u = function() {
   В  В  d({
   В  В В  В В В clearIntervalWhenDevOpenTrigger: !1,
   В  В В  В В В ondevtoolopen: function() {
   В  В В  В В  В В  В window.open("about:blank", "_self")
   В  В В  В В В },
   В  В В  В В В detectors: [0, 1, 3, 4, 5, 6, 7]
   В  В  })
   },
   ```
5. еҸ‘зҺ°жҳҜloadjs жқҘеҠ иҪҪdisable-devtool, йӮЈе°ұжғіеҠһжі•пјҢеңЁ d({})зҡ„ж—¶еҖҷпјҢдҝ®ж”№и®ҫзҪ®е°ұиЎҢгҖӮ

