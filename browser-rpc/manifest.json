{
  "manifest_version": 3,
  "name": "Browser RPC",
  "version": "3.1.0",
  "description": "Extract data from social media platforms via WebSocket RPC",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "958722251@qq.com",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "world": "ISOLATED",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/utils.js",
        "lib/http.js",
        "lib/rpc-page-transport.js",
        "lib/client.js",
        "content/runtime/platform-runtime.js",
        "content/browser/index.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
