{
  "manifest_version": 3,
  "name": "Browser RPC",
  "version": "3.1.0",
  "description": "Extract data from social media platforms via WebSocket RPC",
  "permissions": [
    "activeTab",
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "declarativeNetRequest",
    "cookies",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "958722251@qq.com",
      "strict_min_version": "128.0"
    }
  },
  "content_scripts": [
    {
      "world": "ISOLATED",
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "bridge/bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/utils.js",
        "lib/http.js",
        "lib/rpc-page-transport.js",
        "lib/client.js",
        "content/runtime/platform-runtime.js",
        "content/browser/index.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://*.deepseek.com/*"
      ],
      "js": [
        "content/deepseek/preload.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "background/worker.js",
    "type": "module",
    "scripts": [
      "background/rpc-manager.js",
      "background/browser-actions.js",
      "background/background.js"
    ]
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "sidebar_action": {
    "default_panel": "popup/popup.html",
    "default_title": "Social Media Crawler RPC",
    "default_icon": {
      "16": "static/icon/icon16.png",
      "32": "static/icon/icon32.png"
    }
  },
  "action": {
    "default_title": "Social Media Crawler RPC"
  },
  "icons": {
    "16": "static/icon/icon16.png",
    "32": "static/icon/icon32.png",
    "48": "static/icon/icon48.png",
    "128": "static/icon/icon128.png"
  }
}
